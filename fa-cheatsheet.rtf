\outl0\strokewidth0 \strokec2 <!DOCTYPE html>\
<html lang="zh-CN">\
<head>\
  <meta charset="UTF-8" />\
  <title>FA7 \uc0\u31163 \u32447 \u22270 \u26631 \u24211 </title>\
  <!-- \uc0\u30456 \u23545 \u36335 \u24452 \u65292 \u24403 \u21069 \u25991 \u20214 \u22841 \u20869 \u25214 css -->\
  <link rel="stylesheet" href="./css/svg-with-js.min.css">\
  <style>\
    * \{box-sizing: border-box;\}\
    body \{ padding:24px; font-family: "Source Han Sans SC", Inter, system-ui, sans-serif; \}\
    .search\{padding:8px 12px;width:400px;font-size:16px;margin-bottom:20px;\}\
    .container\{display:grid;grid-template-columns: repeat(auto-fill,120px);gap:8px;\}\
    .item\{border:1px #eee solid;padding:12px;text-align:center;border-radius:4px;cursor:pointer;\}\
    .item:hover\{background:#f5f7fa;\}\
    .item i\{font-size:26px;margin-bottom:6px;display:block;\}\
    .name\{font-size:12px;word-break:break-all;color:#333;\}\
    .tip\{position:fixed;bottom:20px;left:50px;background:#222;color:#fff;padding:6px 10px;border-radius:4px;display:none;\}\
  </style>\
</head>\
<body>\
  <h2>Font Awesome7 Free \uc0\u31163 \u32447 \u22270 \u26631 \u26816 \u32034 </h2>\
  <input class="search" placeholder="\uc0\u25628 \u32034 \u22270 \u26631 \u21517 \u31216 ..." id="searchInput">\
  <div class="container" id="box"></div>\
  <div class="tip" id="tip">\uc0\u24050 \u22797 \u21046 class</div>\
\
  <!-- \uc0\u30456 \u23545 \u36335 \u24452 \u21152 \u36733 fa js -->\
  <script src="./js/all.min.js"></script>\
  <script>\
    let allIcons = [];\
    const box = document.getElementById('box');\
    const searchInput = document.getElementById('searchInput');\
    const tip = document.getElementById('tip');\
\
    // \uc0\u30456 \u23545 \u36335 \u24452 \u35835 \u21462  icons.json\
    fetch("./metadata/icons.json")\
      .then(res=>res.json())\
      .then(json=>\{\
        // \uc0\u36941 \u21382 json\u65292 \u36807 \u28388 free\u22270 \u26631 \u65292 \u29983 \u25104 class\
        Object.entries(json).forEach(([iconName,info])=>\{\
          if(!info.free) return;\
          info.styles.forEach(style=>\{\
            let prefix;\
            if(style==='solid') prefix='fa-solid';\
            else if(style==='regular') prefix='fa-regular';\
            else if(style==='brands') prefix='fa-brands';\
            else return;\
            const className = `$\{prefix\} fa-$\{iconName\}`;\
            allIcons.push(\{className,name:iconName\});\
          \})\
        \})\
        render(allIcons);\
      \})\
\
    function render(list)\{\
      box.innerHTML = '';\
      list.forEach(item=>\{\
        const div = document.createElement('div');\
        div.className='item';\
        div.innerHTML = `<i class="$\{item.className\}"></i><div class="name">$\{item.className\}</div>`\
        div.onclick = ()=>\{\
          navigator.clipboard.writeText(item.className);\
          tip.style.display='block';\
          setTimeout(()=>tip.style.display='none',1200);\
        \}\
        box.appendChild(div);\
      \})\
    \}\
\
    // \uc0\u25628 \u32034 \u36807 \u28388 \
    searchInput.oninput = function()\{\
      const kw = this.value.toLowerCase();\
      const filter = allIcons.filter(i=>i.name.includes(kw))\
      render(filter);\
    \}\
  </script>\
</body>\
</html>\
}